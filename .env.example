# Server configuration
PORT=3000

# MongoDB Atlas connection string (replace <username>, <password>, and <cluster-url> with your Atlas details)
# Example: mongodb+srv://myUser:myPassword@cluster0.abcde.mongodb.net/
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/

# Database name in MongoDB Atlas
DB_NAME=cst3144_after_school
